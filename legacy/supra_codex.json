  "commands": {
    "CHRONOS": {
      "description": "Prevê viabilidade de gaps de lucro e arbitragem",
      "requires": "chronos",
      "action": "rag_query -> parallel_sim -> risk_analysis -> report"
    },
    "EVOLUIR": {
      "description": "Dispara ciclo de auto-otimização hiper-recursiva",
      "requires": "optimization_engine",
      "action": "telemetry -> analysis -> mutation -> validation"
    },
    "SINTETIZAR": {
      "description": "Consolida Néctar colhido em blocos de conhecimento",
      "requires": "alquimia",
      "action": "collect -> distill -> synthesize -> store"
    },
    "HARVEST": {
      "description": "Coleta Néctar de fontes configuradas",
      "requires": "zenith",
      "action": "discover -> extract -> rank -> store"
    },
    "INTELIGENCE": {
      "description": "Coleta inteligência de mercado",
      "requires": "shadow_oracle",
      "action": "scrape -> correlate -> dispatch"
    },
    "PROTECT": {
      "description": "Ativa modo de proteção máxima",
      "requires": "carrasco_guard",
      "action": "monitor -> detect -> alert -> purge"
    },
    "FORJAR": {
      "description": "Ativa The Forge para criar novos ativos",
      "requires": "the_forge",
      "action": "brain_drain -> the_forge -> github -> glitch"
    },
    "DASHBOARD": {
      "description": "Inicia o Nexus Dashboard",
      "requires": "nexus_dashboard",
      "action": "start_server -> render_ui"
    },
    "VALIDATE": {
      "description": "Executa QA Engine",
      "requires": "qa_engine",
      "action": "test_all -> report"
    },
    "DEPLOY": {
      "description": "Executa The Bridge para deploy",
      "requires": "the_bridge",
      "action": "qa -> build -> push -> restart"
    }
